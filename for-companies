<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Companies | Pindari Enterprises</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">
    <nav class="bg-blue-900 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <a href="index.html" class="text-2xl font-bold">Pindari Enterprises</a>
            <div class="hidden md:flex space-x-6">
                <a href="index.html" class="hover:text-amber-400">Home</a>
                <a href="about.html" class="hover:text-amber-400">About Us</a>
                <a href="services.html" class="hover:text-amber-400">Services</a>
                <a href="for-companies.html" class="text-amber-400 font-semibold">For Companies</a>
                <a href="contact.html" class="hover:text-amber-400">Contact Us</a>
            </div>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto px-4 py-10 flex-grow">
        <h1 class="text-3xl font-bold text-blue-900 text-center mb-6">Employer Staffing Portal</h1>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10 text-center">
            <div class="bg-white p-4 rounded shadow border border-blue-100">
                <span class="block font-bold text-blue-900 text-lg">100% Verified</span>
                <span class="text-xs text-gray-500">Background Checked</span>
            </div>
            <div class="bg-white p-4 rounded shadow border border-blue-100">
                <span class="block font-bold text-blue-900 text-lg">Same Day</span>
                <span class="text-xs text-gray-500">Rapid Deployment</span>
            </div>
            <div class="bg-white p-4 rounded shadow border border-blue-100">
                <span class="block font-bold text-blue-900 text-lg">Replacement</span>
                <span class="text-xs text-gray-500">Guaranteed Support</span>
            </div>
            <div class="bg-white p-4 rounded shadow border border-blue-100">
                <span class="block font-bold text-blue-900 text-lg">Contract & Payroll</span>
                <span class="text-xs text-gray-500">Complete Management</span>
            </div>
        </div>

        <div id="employer-form" class="bg-white p-8 rounded-lg shadow-md border">
            <h2 class="text-2xl font-bold text-blue-900 mb-6">Employer Hiring Requirement Form</h2>
            <form id="employerReqForm" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold mb-1">Company Name</label>
                    <input type="text" name="companyName" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">Contact Person</label>
                    <input type="text" name="contactPerson" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">Phone / WhatsApp</label>
                    <input type="tel" name="phone" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">Company Email</label>
                    <input type="email" name="email" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">Category Required</label>
                    <select name="category" class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900">
                        <option value="Skilled/Technical">Skilled / Technical</option>
                        <option value="Industrial Staffing">Industrial Staffing</option>
                        <option value="Semi-Skilled">Semi-Skilled</option>
                        <option value="Unskilled Helper">Unskilled Helper</option>
                        <option value="Office & Support">Office & Support</option>
                        <option value="female only">female only</option>
                        <option value="Security & Housekeeping">Security & Housekeeping</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1">No. of Workers Needed</label>
                    <input type="number" name="workersNeeded" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900">
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold mb-1">Job Location (e.g., Bhosari, Chakan, etc.)</label>
                    <input type="text" name="location" required class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900">
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold mb-1">Detailed Requirements</label>
                    <textarea name="requirements" rows="4" class="w-full border p-2 rounded focus:ring-2 focus:ring-blue-900"></textarea>
                </div>
                <div class="md:col-span-2">
                    <button type="submit" class="w-full bg-blue-900 hover:bg-blue-800 text-white font-bold py-3 rounded shadow transition">Submit Hiring Requirement</button>
                </div>
            </form>
        </div>
    </main>

    <footer class="bg-blue-950 text-white py-6 text-center">
        <p>&copy; 2026 Pindari Enterprises. All rights reserved.</p>
    </footer>

    <script src="js/main.js"></script>
</body>
</html>
